# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.
# Production values live in Railway's environment settings.

# ---------------------------------------------------------------- app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------- supabase
# NOTE: these use Supabase's NEW API key format (sb_publishable_ / sb_secret_),
# not legacy anon/service_role JWTs. The variable NAMES are legacy-styled on
# purpose — see docs/wiki/DECISIONS.md (DEC-003). The keys are opaque strings:
# never decode them as JWTs.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Publishable key — safe in the browser, constrained by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Secret key — SERVER ONLY. Bypasses RLS entirely. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Postgres password, used by the Supabase CLI for `db push`.
SUPABASE_DB_PASSWORD=

# ---------------------------------------------------------------- seed (Phase 1)
# Consumed by `npm run seed` to create the first admin account.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ---------------------------------------------------------------- security (Phase 4)
# 32-byte key, base64 encoded, for AES-256-GCM encryption of provider API keys.
# Generate with: openssl rand -base64 32
ENCRYPTION_MASTER_KEY=

# ---------------------------------------------------------------- providers (Phase 2-3)
# Not required at runtime once keys are managed in the admin panel; useful for
# local development before that exists. Leave every one of these BLANK on a
# deployed instance — an env key silently outranks "no key in the panel", so a
# provider the admin never configured can still spend.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
PERPLEXITY_API_KEY=
CEREBRAS_API_KEY=

# ---------------------------------------------------------------- storage (Phase 6)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ---------------------------------------------------------------- email (Phase 6)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
